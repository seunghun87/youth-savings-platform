# Supabase 프로젝트 설정 > API 에서 확인
# anon 키는 브라우저에 노출되는 공개 키다. RLS로 보호되므로 여기 넣는 것이 맞다.
# service_role 키는 절대 VITE_ 변수에 넣지 말 것 (백엔드 전용)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 백엔드 API 주소.
# 로컬 개발: http://localhost:3000
# Render 배포 후: https://youth-savings-backend.onrender.com (끝에 슬래시 없이)
# 이 값을 Render 주소로 바꾼 뒤에는, 백엔드의 CORS_ORIGIN에 프론트엔드 주소를 넣어야 한다
VITE_API_BASE_URL=http://localhost:3000
